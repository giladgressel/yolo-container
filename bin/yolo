#!/usr/bin/env bash
# yolo — run Claude Code in a YOLO container mounted on $PWD.
#
# SLURM/podman variant. Intended to be run either on a cluster login node or
# on a compute node you've SSH'd into via an interactive SLURM allocation
# (e.g. the rtx6000pro_golden.sh sleep-job trick — `sbatch` a node, then
# `ssh` into it and work there).
#
# One shared image (yolo-claude:latest) built from this repo's .devcontainer/
# dir. Bind-mounts $PWD to /workspace. Container's .venv is an anonymous
# volume so it never collides with the host's .venv (glibc/ABI mismatch
# between RHEL9 host and Debian container). uv cache is a shared named
# volume.
#
# Host Claude config (CLAUDE.md, settings, skills, statusline) is mounted
# READ-ONLY. Changes made inside the container stay inside. To push a change
# back to the host, copy it out manually (the "over-the-wall" flow).
#
# GPU passthrough is auto-detected: if CDI is configured, uses
# `--device nvidia.com/gpu=all`; else if /dev/nvidiactl exists, bind-mounts
# the nvidia device nodes and driver userspace libs. On the login node
# (no GPU) it silently skips.

set -euo pipefail

IMAGE="yolo-claude:latest"
ENGINE="${YOLO_ENGINE:-podman}"

# Resolve this script's real location (follows symlinks, so ~/.local/bin/yolo
# can symlink into the repo). CTX is the .devcontainer dir next to bin/.
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
REPO_DIR="$(cd -P "$(dirname "$SCRIPT")/.." && pwd)"
CTX="$REPO_DIR/.devcontainer"

if ! command -v "$ENGINE" >/dev/null 2>&1; then
  echo "yolo: $ENGINE CLI not found. Set YOLO_ENGINE=docker if you have docker instead." >&2
  exit 1
fi

# Persistent per-user state on NFS ($HOME is NFS-shared across all nodes).
# Podman named volumes live inside the graphroot, which storage.conf puts on
# node-local /tmp (the overlay driver can't run on NFS) — so anything kept in
# a named volume silently dies on a node hop. Claude login/sessions and shell
# history must survive node changes, so they're plain bind mounts under $HOME
# instead. uv caches stay in named volumes on purpose: they're pure caches
# (cheap to refill) and uv hardlinks out of them, which NFS handles poorly.
STATE_DIR="${YOLO_STATE_DIR:-$HOME/.local/state/yolo}"
mkdir -p "$STATE_DIR/claude" "$STATE_DIR/bashhistory"

# Image cache on NFS: podman's image store is node-local /tmp (see above), so
# a fresh node has no image. A `podman save` tarball on NFS turns "rebuild
# from scratch + network pulls (~minutes)" into "podman load (~1 min)".
# Best-effort: a failed save (disk quota, …) never blocks the run.
# YOLO_IMAGE_CACHE=0 disables both save and load.
IMAGE_TAR="$STATE_DIR/yolo-claude-image.tar"
save_image() {
  [ "${YOLO_IMAGE_CACHE:-1}" = "1" ] || return 0
  echo "yolo: caching image to $IMAGE_TAR (fast reuse on other nodes)..." >&2
  if "$ENGINE" save -o "$IMAGE_TAR.tmp" "$IMAGE" && mv "$IMAGE_TAR.tmp" "$IMAGE_TAR"; then
    :
  else
    rm -f "$IMAGE_TAR.tmp"
    echo "yolo: warning — couldn't cache image to NFS (quota?); new nodes will rebuild" >&2
  fi
}

# `yolo --update` (aliases: --rebuild, -u): rebuild the image from scratch so the
# baked-in Claude Code CLI tracks the current @latest, then exit. The Dockerfile
# pins @latest, but that's a constant string, so an ordinary rebuild hits the
# layer cache and reinstalls the same stale CLI. --no-cache forces the refresh;
# --pull also refreshes the node:20 base.
if [ "${1:-}" = "--update" ] || [ "${1:-}" = "--rebuild" ] || [ "${1:-}" = "-u" ]; then
  echo "yolo: rebuilding $IMAGE from scratch (pulls latest Claude Code; a few minutes)..." >&2
  "$ENGINE" build --pull --no-cache -t "$IMAGE" "$CTX"
  save_image
  printf 'yolo: done. Claude Code in image is now: ' >&2
  "$ENGINE" run --rm --entrypoint /usr/local/share/npm-global/bin/claude "$IMAGE" --version 2>/dev/null \
    || echo "(version check failed)" >&2
  exit 0
fi

if ! "$ENGINE" image inspect "$IMAGE" >/dev/null 2>&1; then
  if [ "${YOLO_IMAGE_CACHE:-1}" = "1" ] && [ -f "$IMAGE_TAR" ]; then
    echo "yolo: image not on this node — loading cached tarball from NFS (~1 min)..." >&2
    if ! "$ENGINE" load -i "$IMAGE_TAR"; then
      echo "yolo: load failed — building instead..." >&2
      "$ENGINE" build -t "$IMAGE" "$CTX"
      save_image
    fi
  else
    echo "yolo: building $IMAGE (first run — a few minutes)..." >&2
    "$ENGINE" build -t "$IMAGE" "$CTX"
    save_image
  fi
fi

# One-time migration: adopt state from the old node-local named volumes if the
# NFS dirs are still empty and the volumes exist on this node.
migrate_volume() {
  local vol="$1" dest="$2" mp
  [ -n "$(ls -A "$dest" 2>/dev/null)" ] && return 0
  "$ENGINE" volume inspect "$vol" >/dev/null 2>&1 || return 0
  mp=$("$ENGINE" volume inspect --format '{{.Mountpoint}}' "$vol" 2>/dev/null) || return 0
  [ -d "$mp" ] || return 0
  cp -a "$mp/." "$dest/" 2>/dev/null || true
  echo "yolo: migrated $vol (node-local volume) -> $dest" >&2
}
migrate_volume yolo-claude-config "$STATE_DIR/claude"
migrate_volume yolo-bashhistory  "$STATE_DIR/bashhistory"

args=(
  --rm -it
  # SELinux: disable label enforcement for bind mounts. On RHEL9 the safer
  # `:z` / `:Z` suffixes relabel source files, which we don't want for
  # shared home dotfiles or NFS-backed workspaces.
  --security-opt label=disable
  -v "$PWD:/workspace" -w /workspace
  -v /workspace/.venv
  -v yolo-uv-cache:/home/node/.cache/uv
  -v yolo-uv-data:/home/node/.local/share/uv
  # NFS bind mounts, NOT named volumes — must survive node hops (see STATE_DIR
  # comment above). claude/ holds login, .claude.json, and all sessions.
  -v "$STATE_DIR/claude:/home/node/.claude"
  -v "$STATE_DIR/bashhistory:/commandhistory"
  -e CLAUDE_CONFIG_DIR=/home/node/.claude
  # Single-UID mode forces the container to run as root (uid 0), and Claude
  # refuses `--dangerously-skip-permissions` as root unless it knows it's
  # sandboxed. This rootless container is exactly that, so flag it — otherwise
  # the `cg` alias errors with "cannot be used with root/sudo privileges".
  -e IS_SANDBOX=1
)

# Make the `cluster` helper available on PATH inside every container, from any
# project. The yolo container has no SLURM client; `cluster <cmd>` runs slurm
# commands on the login node over the forwarded ssh-agent (see bin/cluster).
# Mounted from this repo (on NFS) so it works regardless of which project dir
# you launched from, and edits to the helper need no image rebuild.
[ -x "$REPO_DIR/bin/cluster" ] && args+=(-v "$REPO_DIR/bin/cluster:/usr/local/bin/cluster:ro")

# Git worktree support. In a linked worktree (Orca, `git worktree add`, …) the
# .git inside $PWD is a FILE pointing at .git/worktrees/<name> in the main repo,
# which lives outside the $PWD bind mount. Without this, every `git` command in
# the container fails because the gitdir pointer doesn't resolve.
#
# Fix: locate the main repo's .git via the worktree's commondir, then mount it
# at the same host path inside the container. The worktree's per-branch dir
# (.git/worktrees/<name>) is a child of that, so one mount covers both.
if [ -f "$PWD/.git" ]; then
  worktree_gitdir=$(sed -n 's/^gitdir: //p' "$PWD/.git" 2>/dev/null || true)
  if [ -n "$worktree_gitdir" ] && [ -d "$worktree_gitdir" ] && [ -f "$worktree_gitdir/commondir" ]; then
    commondir_raw=$(cat "$worktree_gitdir/commondir")
    if [ "${commondir_raw:0:1}" = "/" ]; then
      main_gitdir="$commondir_raw"
    else
      main_gitdir=$(cd -P "$worktree_gitdir/$commondir_raw" 2>/dev/null && pwd || true)
    fi
    if [ -n "$main_gitdir" ] && [ -d "$main_gitdir" ]; then
      args+=(-v "$main_gitdir:$main_gitdir")
      echo "yolo: linked worktree detected — mounting $main_gitdir for git access" >&2
    else
      echo "yolo: warning — couldn't resolve main .git from worktree (commondir=$commondir_raw); git will be broken in container" >&2
    fi
  fi
fi

# --- Project mount manifest ----------------------------------------------
# A project can declare extra host paths to bind-mount by listing them in a
# manifest at the repo root (default: .yolo-mounts; override with
# YOLO_MOUNTS_FILE). This is the "don't retype -v flags every run" feature:
# centralized datasets, scratch dirs, shared model caches that live outside
# $PWD get mounted automatically when you `yolo`.
#
# SAFETY: these are typically directories shared with the whole team, so every
# manifest mount is READ-ONLY by default. A line must explicitly end in :rw to
# be writable, and any :rw mount triggers a loud warning + typed confirmation
# (since the container writes as your real host user — a bad write to shared
# data is real and permanent). Bypass the prompt with YOLO_ALLOW_WRITE=1.
#
# One mount per line, using the same syntax as `podman -v`:
#
#   /data/shared/corpus                  # same path inside, READ-ONLY
#   /data/shared/corpus:/data/corpus     # custom target inside, READ-ONLY
#   /data/shared/outputs/$USER:...:rw    # explicitly writable (prompts!)
#   ~/datasets:/datasets                 # leading ~ expands to $HOME
#
# Blank lines and everything after a # are ignored. A bare path mounts at the
# identical path inside the container (so absolute paths baked into configs/
# code still resolve). Missing sources are warned about and skipped, never
# fatal — a stale entry on one machine won't abort the run.
MOUNTS_FILE="${YOLO_MOUNTS_FILE:-$PWD/.yolo-mounts}"
if [ -f "$MOUNTS_FILE" ]; then
  mount_count=0
  writable_mounts=()
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"                        # strip trailing comment
    line="${line#"${line%%[![:space:]]*}"}"   # ltrim
    line="${line%"${line##*[![:space:]]}"}"   # rtrim
    [ -z "$line" ] && continue

    src="${line%%:*}"                         # field before first colon
    rest=""
    [ "$line" != "$src" ] && rest="${line#*:}"
    src="${src/#\~/$HOME}"                     # expand leading ~ on source
    if [ ! -e "$src" ]; then
      echo "yolo: warning — mount source not found, skipping: $src ($(basename "$MOUNTS_FILE"))" >&2
      continue
    fi

    # Split the remainder into destination + options.
    dst="$src"; opts=""                       # bare path → same path inside
    if [ -n "$rest" ]; then
      dst="${rest%%:*}"
      [ "$rest" != "$dst" ] && opts="${rest#*:}"
      dst="${dst/#\~/$HOME}"                   # expand leading ~ on target too
    fi

    # Read-only unless the line explicitly opts into rw. Anything that isn't a
    # clear :rw (including a typo) fails safe to :ro.
    case ",$opts," in
      *,rw,*) args+=(-v "$src:$dst:rw"); writable_mounts+=("$src -> $dst") ;;
      *)      args+=(-v "$src:$dst:ro") ;;
    esac
    mount_count=$((mount_count + 1))
  done < "$MOUNTS_FILE"

  # Friction gate for writable shared mounts: warn loudly, then require a typed
  # confirmation. Fail closed if there's no TTY to ask. YOLO_ALLOW_WRITE=1 skips
  # the prompt for scripted / non-interactive use.
  if [ "${#writable_mounts[@]}" -gt 0 ] && [ "${YOLO_ALLOW_WRITE:-0}" != "1" ]; then
    {
      echo ""
      echo "yolo: ⚠️  WRITABLE shared mounts requested via :rw in $(basename "$MOUNTS_FILE")"
      echo "yolo:     Claude will be able to MODIFY or DELETE real files at:"
      for m in "${writable_mounts[@]}"; do echo "yolo:        • $m"; done
      echo "yolo:     These paths may be shared with your team — writes are permanent."
      echo ""
    } >&2
    if [ ! -e /dev/tty ] && [ ! -t 0 ]; then
      echo "yolo: no TTY to confirm writable mounts — refusing. Set YOLO_ALLOW_WRITE=1 to allow." >&2
      exit 1
    fi
    printf "yolo: type 'yes' to mount these writable, anything else to abort: " >&2
    if [ -e /dev/tty ]; then read -r reply < /dev/tty || reply=""; else read -r reply || reply=""; fi
    if [ "$reply" != "yes" ]; then
      echo "yolo: aborted — writable shared mounts not confirmed." >&2
      exit 1
    fi
  fi

  [ "$mount_count" -gt 0 ] && \
    echo "yolo: mounted $mount_count path(s) from $(basename "$MOUNTS_FILE") (${#writable_mounts[@]} writable)" >&2
fi

# SSH agent forwarding. Prefer the live socket inherited from the launching
# shell. If that's stale — e.g. a tmux pane reattached from a different client,
# so $SSH_AUTH_SOCK still points at a forwarded socket that died with the old
# connection — fall back to the stable ~/.ssh/agent.sock symlink that a fresh
# shell keeps pointed at the current live agent (see hosts/<host>.zsh snippet
# in the README). Refresh that symlink from whatever we settle on, then mount
# it so the container always has one stable source path.
#
# Note: a running container's bind mount is pinned at launch, so after you
# switch clients you must re-run yolo to pick up the now-live socket — the
# symlink just makes that a clean restart instead of a reconfigure.
ssh_sock="${SSH_AUTH_SOCK:-}"
if [ ! -S "$ssh_sock" ] && [ -S "$HOME/.ssh/agent.sock" ]; then
  ssh_sock="$HOME/.ssh/agent.sock"
fi
if [ -S "$ssh_sock" ]; then
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" 2>/dev/null || true
  ln -sf "$ssh_sock" "$HOME/.ssh/agent.sock" 2>/dev/null || true
  args+=(-v "$HOME/.ssh/agent.sock:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
else
  echo "yolo: warning — no live SSH agent socket (SSH_AUTH_SOCK='${SSH_AUTH_SOCK:-}')." >&2
  echo "yolo:   git/ssh over SSH won't work in the container. Reconnect with agent" >&2
  echo "yolo:   forwarding (ssh -A / 'ForwardAgent yes'), confirm with 'ssh-add -l'," >&2
  echo "yolo:   then re-run yolo." >&2
fi

# --- GPU passthrough (auto-detect) ---------------------------------------
gpu_mode="none"
if command -v nvidia-ctk >/dev/null 2>&1 && \
   { [ -d /etc/cdi ] || [ -d /var/run/cdi ]; } && \
   ls /etc/cdi/nvidia*.yaml /var/run/cdi/nvidia*.yaml >/dev/null 2>&1; then
  args+=(--device nvidia.com/gpu=all)
  gpu_mode="cdi"
elif [ -e /dev/nvidiactl ]; then
  # Raw device + driver lib bind mount (no nvidia-container-toolkit on host).
  # Passes only the nvidia* devices visible to this process — under an
  # interactive SLURM session, cgroups limit visibility to the allocated GPU.
  for dev in /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset; do
    [ -e "$dev" ] && args+=(--device "$dev")
  done
  for dev in /dev/nvidia[0-9]*; do
    [ -e "$dev" ] && args+=(--device "$dev")
  done
  # Driver userspace libs — the container's CUDA runtime dlopens these.
  # nvidia-smi is handy for sanity checks.
  for lib in /usr/lib64/libcuda.so* /usr/lib64/libnvidia-ml.so* \
             /usr/lib64/libnvidia-ptxjitcompiler.so* /usr/lib64/libnvidia-nvvm.so*; do
    [ -e "$lib" ] && args+=(-v "$lib:$lib:ro")
  done
  [ -x /usr/bin/nvidia-smi ] && args+=(-v /usr/bin/nvidia-smi:/usr/bin/nvidia-smi:ro)
  gpu_mode="devices"
fi

# Host config read-only (CLAUDE.md, settings, skills, statusline, starship, netrc, gitconfig).
# Each mount is conditional on the host file existing — missing files are silently skipped.
# `return 0` so a missing file (the common case) doesn't make the function
# exit non-zero and trip `set -e`.
add_ro() { [ -e "$1" ] && args+=(-v "$1:$2:ro"); return 0; }
add_ro_first() {
  # First candidate that exists wins; lets us prefer standard paths and fall back to dotfiles layouts.
  local target="$1"; shift
  for candidate in "$@"; do
    if [ -e "$candidate" ]; then
      args+=(-v "$candidate:$target:ro")
      return
    fi
  done
}
add_ro "$HOME/.claude/CLAUDE.md"             /home/node/.claude/CLAUDE.md
add_ro "$HOME/.claude/settings.json"         /home/node/.claude/settings.json
add_ro "$HOME/.claude/settings.local.json"   /home/node/.claude/settings.local.json
add_ro "$HOME/.claude/skills"                /home/node/.claude/skills
add_ro "$HOME/.agents/skills"                /home/node/.agents/skills
add_ro "$HOME/.claude/statusline-command.sh" /home/node/.claude/statusline-command.sh
add_ro "$HOME/.claude.json"                  /yolo/host-claude.json
add_ro_first                                 /home/node/.config/starship.toml \
  "$HOME/.config/starship.toml" \
  "$HOME/.dotfiles/starship.toml"
add_ro "$HOME/.netrc"                        /home/node/.netrc
add_ro "$HOME/.gitconfig"                    /home/node/.gitconfig
add_ro "$HOME/.modal.toml"                   /home/node/.modal.toml

# Forward WANDB_API_KEY so the wandb HTTP MCP can authenticate
if [ -n "${WANDB_API_KEY:-}" ]; then
  args+=(-e WANDB_API_KEY)
fi

# Forward ANTHROPIC_API_KEY if set (optional — otherwise use `claude` interactive login)
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  args+=(-e ANTHROPIC_API_KEY)
fi

# Forward GH_TOKEN so gh CLI is pre-authenticated inside the container
if [ -n "${GH_TOKEN:-}" ]; then
  args+=(-e GH_TOKEN)
fi

# Forward ORCA_WORKTREE_ID so Claude inside the container knows it's in an
# Orca-managed worktree (drives the Delete/Sleep guidance in CLAUDE.md). Other
# ORCA_* vars are skipped: they reference host-only paths or a hook port that
# isn't reachable from the container without extra networking plumbing.
if [ -n "${ORCA_WORKTREE_ID:-}" ]; then
  args+=(-e ORCA_WORKTREE_ID)
fi

# SLURM-from-container config for the `cluster` helper. The image has no slurm
# client; `cluster` ssh'es to your login node and runs slurm there. The login
# host, username, and which agent key to use are USER-SPECIFIC, so they live in
# a local, uncommitted file — never in this repo. Source it if present and
# forward the values. Always forward the real host path of /workspace
# (YOLO_WS_HOST=$PWD) so `cluster` can translate paths for jobs that run on
# compute nodes, where /workspace doesn't exist. See cluster.env.example.
CLUSTER_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/yolo/cluster.env"
# shellcheck disable=SC1090
[ -f "$CLUSTER_ENV" ] && . "$CLUSTER_ENV"
args+=(-e "YOLO_WS_HOST=$PWD")
for v in YOLO_SLURM_LOGIN YOLO_SLURM_USER YOLO_SLURM_KEY YOLO_WS_CONTAINER; do
  [ -n "${!v:-}" ] && args+=(-e "$v=${!v}")
done

# Server-resident SSH key (optional). A passphrase-less key that lives on the
# cluster so `cluster` and `git push` keep working when the laptop — and the
# forwarded ssh-agent it carries — is detached. YOLO_SLURM_KEYFILE in cluster.env
# is the HOST path; we mount it read-only at a fixed container path and forward
# THAT path, so `cluster` and the in-container git config both find it. The key's
# host perms (0600) carry through the read-only mount, which ssh requires.
if [ -n "${YOLO_SLURM_KEYFILE:-}" ]; then
  if [ -f "$YOLO_SLURM_KEYFILE" ]; then
    add_ro "$YOLO_SLURM_KEYFILE" /home/node/.ssh/yolo_server
    args+=(-e "YOLO_SLURM_KEYFILE=/home/node/.ssh/yolo_server")
  else
    echo "yolo: warning — YOLO_SLURM_KEYFILE=$YOLO_SLURM_KEYFILE not found; skipping" >&2
    echo "yolo:   the server-key mount. cluster/git will fall back to the ssh-agent." >&2
  fi
fi

echo "yolo: engine=$ENGINE gpu=$gpu_mode workspace=$PWD" >&2

exec "$ENGINE" run "${args[@]}" "$IMAGE" \
  bash -lc '
    set -e

    # Sync mcpServers from host ~/.claude.json into container config.
    # CLAUDE_CONFIG_DIR redirects where the CLI reads/writes .claude.json, so
    # we must honor it — default $HOME/.claude.json is wrong when the env var is set.
    if [ -f /yolo/host-claude.json ]; then
      target="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
      host_mcps=$(jq -c ".mcpServers // {}" /yolo/host-claude.json 2>/dev/null || echo "{}")
      if [ -f "$target" ]; then
        jq --argjson m "$host_mcps" ".mcpServers = \$m" "$target" > "$target.tmp" && mv "$target.tmp" "$target"
      else
        echo "{\"mcpServers\": $host_mcps}" | jq . > "$target"
      fi
      count=$(echo "$host_mcps" | jq "keys | length")
      echo "yolo: synced $count MCP server(s) from host -> $target"
    fi

    # Server-resident SSH key: make git push use it for github.com. A per-host
    # ssh_config block (not GIT_SSH_COMMAND) so only github.com is pinned to this
    # key; any other ssh still falls through to the forwarded agent when present.
    # Requires the remote to be the SSH form git@github.com:owner/repo.git.
    if [ -n "${YOLO_SLURM_KEYFILE:-}" ] && [ -f "$YOLO_SLURM_KEYFILE" ]; then
      mkdir -p ~/.ssh && chmod 700 ~/.ssh
      if ! grep -q "yolo_server" ~/.ssh/config 2>/dev/null; then
        printf "Host github.com\n  IdentityFile %s\n  IdentitiesOnly yes\n" \
          "$YOLO_SLURM_KEYFILE" >> ~/.ssh/config
        chmod 600 ~/.ssh/config
      fi
    fi

    # Python project: sync deps into container-local .venv (anonymous volume)
    if [ -f pyproject.toml ] && [ ! -x .venv/bin/python ]; then
      echo "yolo: running uv sync..."
      uv sync
    fi

    exec zsh
  '
